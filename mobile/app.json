{
  "expo": {
    "name": "SHALOM",
    "slug": "shalom-offline",
    "scheme": "shalom",
    "version": "0.4.19",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shalomcoroacordes.cancionero"
    },
    "android": {
      "package": "com.shalomcoroacordes.cancionero",
      "edgeToEdgeEnabled": true,
      "versionCode": 42,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#006D3B"
      }
    },
    "extra": {
      "source": "ehpvsasyzlrlypjjpzuk"
    },
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite elegir fotografías para las portadas de tus colecciones personales. No se suben a internet.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
