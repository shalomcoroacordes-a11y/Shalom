{
  "expo": {
    "name": "SHALOM Admin",
    "slug": "shalom-admin",
    "scheme": "shalomadmin",
    "version": "0.1.2",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.shalomcoroacordes.admin",
      "versionCode": 3,
      "edgeToEdgeEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#063221"
      }
    },
    "ios": {
      "bundleIdentifier": "com.shalomcoroacordes.admin",
      "supportsTablet": true
    },
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ]
  }
}
